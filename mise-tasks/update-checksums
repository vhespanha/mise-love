#!/usr/bin/env bash
#MISE description="Regenerate lib/checksums.lua with sha256 hashes of LÖVE release assets"
set -euo pipefail

# platform key -> asset name pattern (must match lib/releases.lua)
declare -A PATTERNS=(
    ["linux-amd64"]='x86_64\.AppImage$'
    ["linux-386"]='i686\.AppImage$'
    ["darwin"]='macos\.zip$'
    ["windows-amd64"]='win64\.zip$'
    ["windows-386"]='win32\.zip$'
)

out="lib/checksums.lua"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

releases=$(curl -fsSL ${GITHUB_TOKEN:+-H "Authorization: Bearer $GITHUB_TOKEN"} \
    "https://api.github.com/repos/love2d/love/releases?per_page=100")

{
    echo "-- Generated by mise-tasks/update-checksums. Do not edit by hand."
    echo "return {"
    for tag in $(jq -r '.[] | select(.draft | not) | .tag_name' <<<"$releases"); do
        major=${tag%%.*}
        if ((major < 11)); then
            continue
        fi
        echo "    [\"$tag\"] = {"
        for platform in $(printf '%s\n' "${!PATTERNS[@]}" | sort); do
            asset=$(jq -r --arg tag "$tag" --arg re "${PATTERNS[$platform]}" \
                '.[] | select(.tag_name == $tag) | .assets[] | select(.name | test($re)) | .name' <<<"$releases" | head -n1)
            if [[ -z $asset ]]; then
                continue
            fi
            echo "  $tag $platform $asset" >&2
            sha=$(curl -fsSL "https://github.com/love2d/love/releases/download/$tag/$asset" | sha256sum | cut -d' ' -f1)
            echo "        [\"$platform\"] = { file = \"$asset\", sha256 = \"$sha\" },"
        done
        echo "    },"
    done
    echo "}"
} >"$tmp"

mv "$tmp" "$out"
stylua "$out"
echo "Wrote $out"
